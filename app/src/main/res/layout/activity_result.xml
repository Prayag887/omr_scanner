<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:shimmer="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="#FAFAFA"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OMR Result"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#333"
        android:paddingBottom="12dp" />

    <!-- Scrollable shimmer + real results area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="ifContentScrolls">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Actual result container (initially hidden) -->
            <LinearLayout
                android:id="@+id/resultsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingBottom="12dp" />

            <!-- Shimmer cards container -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                shimmer:auto_start="true"
                shimmer:duration="1500">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Dummy shimmer cards -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        card_view:cardCornerRadius="16dp"
                        card_view:cardElevation="4dp"
                        card_view:cardBackgroundColor="#DDDDDD">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="#CCCCCC" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        card_view:cardCornerRadius="16dp"
                        card_view:cardElevation="4dp"
                        card_view:cardBackgroundColor="#DDDDDD">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="#CCCCCC" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        card_view:cardCornerRadius="16dp"
                        card_view:cardElevation="4dp"
                        card_view:cardBackgroundColor="#DDDDDD">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="#CCCCCC" />
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        card_view:cardCornerRadius="16dp"
                        card_view:cardElevation="4dp"
                        card_view:cardBackgroundColor="#DDDDDD">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="#CCCCCC" />
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        card_view:cardCornerRadius="16dp"
                        card_view:cardElevation="4dp"
                        card_view:cardBackgroundColor="#DDDDDD">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="#CCCCCC" />
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        card_view:cardCornerRadius="16dp"
                        card_view:cardElevation="4dp"
                        card_view:cardBackgroundColor="#DDDDDD">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="#CCCCCC" />
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        card_view:cardCornerRadius="16dp"
                        card_view:cardElevation="4dp"
                        card_view:cardBackgroundColor="#DDDDDD">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="#CCCCCC" />
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        card_view:cardCornerRadius="16dp"
                        card_view:cardElevation="4dp"
                        card_view:cardBackgroundColor="#DDDDDD">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="#CCCCCC" />
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        card_view:cardCornerRadius="16dp"
                        card_view:cardElevation="4dp"
                        card_view:cardBackgroundColor="#DDDDDD">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="#CCCCCC" />
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        card_view:cardCornerRadius="16dp"
                        card_view:cardElevation="4dp"
                        card_view:cardBackgroundColor="#DDDDDD">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="#CCCCCC" />
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        card_view:cardCornerRadius="16dp"
                        card_view:cardElevation="4dp"
                        card_view:cardBackgroundColor="#DDDDDD">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="#CCCCCC" />
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        card_view:cardCornerRadius="16dp"
                        card_view:cardElevation="4dp"
                        card_view:cardBackgroundColor="#DDDDDD">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="#CCCCCC" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

        </FrameLayout>
    </ScrollView>

    <!-- Back Button -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back"
        android:backgroundTint="#1976D2"
        android:textColor="#FFF"
        android:layout_marginTop="8dp" />
</LinearLayout>
